# =====================================================================
# JimBot : variables d'environnement (EXEMPLE, aucune valeur réelle)
# À saisir dans Vercel > Project > Settings > Environment Variables.
# Ne jamais committer de fichier .env contenant des valeurs.
# Guide : jimbot/docs/GUIDE-CONFIGURATION.md
# =====================================================================

# --- Site -------------------------------------------------------------
# URL publique utilisée dans le lien de l'e-mail vers l'administration
JIMBOT_SITE_URL=https://www.workflowintelligent.fr
# Origines autorisées à appeler l'API (séparées par des virgules).
# En prévisualisation, ajouter l'URL de la prévisualisation.
JIMBOT_ALLOWED_ORIGINS=https://www.workflowintelligent.fr,https://workflowintelligent.fr
# SECRET. Sel des empreintes (jeton de session, IP). Chaîne aléatoire >= 32 caractères.
# Le changer invalide les sessions en cours.
JIMBOT_HASH_SALT=

# --- Supabase ---------------------------------------------------------
SUPABASE_URL=https://<ref-du-projet>.supabase.co
# SECRET. Clé service_role (JWT) ou clé secrète « sb_secret_… ». Serveur uniquement.
SUPABASE_SERVICE_ROLE_KEY=
# Clé publique anon (JWT) ou « sb_publishable_… » : utilisée côté serveur
# pour Supabase Auth (connexion de l'administrateur). Non secrète.
SUPABASE_ANON_KEY=

# --- Vapi (chat textuel) ---------------------------------------------
# SECRET. Clé API privée Vapi (Dashboard > API Keys > Private).
VAPI_PRIVATE_KEY=
# Identifiant de l'assistant JimBot (créé par npm run jimbot:vapi-setup). Non secret.
JIMBOT_VAPI_ASSISTANT_ID=
# SECRET. Jeton que Vapi envoie à l'outil de recherche (Authorization: Bearer …).
# Même valeur que la credential « Bearer Token » créée dans Vapi.
JIMBOT_VAPI_TOOL_SECRET=
# Délai maximal d'une réponse Vapi (ms)
JIMBOT_VAPI_TIMEOUT_MS=25000

# --- Embeddings des requêtes (doivent correspondre aux documents) -----
# SECRET. Clé API OpenAI utilisée uniquement pour vectoriser les requêtes.
OPENAI_API_KEY=
JIMBOT_EMBEDDING_MODEL=text-embedding-3-small
JIMBOT_EMBEDDING_DIMENSIONS=1536
# Nombre d'extraits renvoyés et similarité minimale (0 à 1)
JIMBOT_MATCH_COUNT=6
JIMBOT_MIN_SIMILARITY=0.3

# --- Limites -----------------------------------------------------------
JIMBOT_MAX_MESSAGE_CHARS=1000
JIMBOT_MAX_MESSAGES_PER_CONVERSATION=60
JIMBOT_RATE_CHAT_PER_MINUTE=8
JIMBOT_RATE_CHAT_PER_DAY=150
JIMBOT_RATE_CONTACT_PER_HOUR=5
JIMBOT_RATE_ADMIN_LOGIN_PER_15MIN=10
JIMBOT_RATE_TOOL_PER_MINUTE=120

# --- Notification e-mail ----------------------------------------------
# « smtp » (messagerie Gandi) ou « resend »
JIMBOT_MAIL_PROVIDER=smtp
# Expéditeur autorisé : la boîte Gandi authentifiée (ou un alias de cette boîte).
JIMBOT_MAIL_FROM=JimBot <adresse-de-la-boite@workflowintelligent.fr>
# Destinataire : adresse professionnelle de Sylvain
JIMBOT_NOTIFY_TO=
JIMBOT_SMTP_HOST=mail.gandi.net
# 465 (TLS implicite, recommandé) ou 587 (STARTTLS)
JIMBOT_SMTP_PORT=465
JIMBOT_SMTP_USER=adresse-de-la-boite@workflowintelligent.fr
# SECRET. Mot de passe de la boîte Gandi utilisée pour l'envoi.
JIMBOT_SMTP_PASSWORD=
# SECRET. Seulement si JIMBOT_MAIL_PROVIDER=resend (domaine vérifié chez Resend).
RESEND_API_KEY=
JIMBOT_MAIL_TIMEOUT_MS=12000
JIMBOT_MAIL_MAX_ATTEMPTS=5

# --- Administration ------------------------------------------------------
# Adresse(s) autorisée(s). Le compte doit AUSSI figurer dans la table jimbot_admins.
JIMBOT_ADMIN_EMAILS=

# --- Purge planifiée -------------------------------------------------------
# SECRET. Vercel l'envoie automatiquement à la tâche planifiée (Authorization: Bearer).
CRON_SECRET=

# --- Uniquement pour scripts/jimbot-vapi-setup.mjs (poste local) ---------
# URL publique de l'outil, ex. https://www.workflowintelligent.fr/api/jimbot/vapi-tool
JIMBOT_VAPI_TOOL_URL=
# Identifiant de la credential Bearer créée dans Vapi (non secret)
JIMBOT_VAPI_CREDENTIAL_ID=
# Modèle de langage de l'assistant : à choisir parmi ceux proposés par Vapi
JIMBOT_VAPI_MODEL_PROVIDER=openai
JIMBOT_VAPI_MODEL=
# Renseigner après la première création pour mettre à jour au lieu de recréer
JIMBOT_VAPI_TOOL_ID=
